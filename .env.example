# frontend/.env.local – both values are public (Supabase → Project Settings → API).
# Security comes from Row Level Security in the database, not from hiding these.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Secrets (TMDb etc.) are NOT stored here. They live in Supabase → Edge Functions → Secrets.
